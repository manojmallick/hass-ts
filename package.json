{
  "name": "hass-ts",
  "version": "0.1.0",
  "private": false,
  "description": "A TypeScript Home Assistant client with domain helpers, entity code generation, and MCP tools.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hass-ts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build",
    "codegen:sample": "node dist/cli.js codegen --from-file fixtures/sample-states.json -o fixtures/ha-entities.sample.ts",
    "changeset": "changeset",
    "postinstall": "sigmap",
    "map:refresh": "sigmap",
    "map:report": "sigmap --report --json",
    "map:watch": "sigmap daemon start",
    "map:setup": "sigmap --setup"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.0.0",
    "sigmap": "^8.18.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {},
  "keywords": [
    "home-assistant",
    "hass",
    "typescript",
    "sdk",
    "iot",
    "mcp",
    "codegen"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/manojmallick/hass-ts.git"
  }
}
